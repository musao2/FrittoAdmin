# FRITTO HR System — Environment Variables
# Bu faylni .env nomiga ko'chirib, qiymatlarni to'ldiring

# Supabase loyihangizdan oling:
# Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase loyihangizdan oling:
# Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# MUHIM: service_role kalitini HECH QACHON bu faylga qo'shmang!
# service_role kaliti faqat server tomonida (Edge Functions) ishlatilsin.
